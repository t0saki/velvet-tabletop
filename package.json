{
  "name": "velvet-tabletop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "天鹅绒桌游盒 · Velvet Tabletop — 6-10 Player Commercial LAN Party Game Suite",
  "repository": {
    "type": "git",
    "url": "https://github.com/t0saki/velvet-tabletop.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:videos": "tsx scripts/generate-videos.ts",
    "gen:audio": "tsx scripts/generate-audio.ts",
    "gen:flagship-art": "tsx scripts/generate-flagship-art.ts",
    "gen:flagship-videos": "tsx scripts/generate-flagship-videos.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/canvas-confetti": "^1.6.4",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^8.3.8",
    "vitest": "^3.0.7"
  }
}
