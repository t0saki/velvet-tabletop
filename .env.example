# HTTP server port (avoid 5000 / 7000 on macOS where AirPlay Receiver listens)
PORT=3210

# Optional: Volcengine Doubao Voice API key (single key auth for V3 seed-tts-2.0 / seed-audio-1.0)
# Note: All 74 bilingual judge/dealer voice clips and 3 BGM loops are pre-bundled in public/audio/
# for 100% offline LAN play. Only needed for live dynamic Sketch Exhibition TTS or `pnpm gen:audio`.
# Falls back cleanly to browser Web Speech synthesis when unset.
DOUBAO_API_KEY=

# Optional: Volcengine ARK API key for Seedream 5.5 & Seedance 2.5
# Note: All role portraits, avatars, covers, and 720p stage video loops are pre-bundled in public/.
# Only needed if regenerating visual assets via `pnpm gen:flagship-art` or `pnpm gen:flagship-videos`.
ARK_API_KEY=
